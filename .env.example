# Copy this file to .env and fill in real values. Never commit .env.

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# Local development uses api_key. App Service uses managed_identity.
AZURE_OPENAI_AUTH_MODE=api_key
AZURE_OPENAI_API_KEY=
# Keep this aligned with RagSettings' default unless Azure requires a change.
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Required by DefaultAzureCredential when App Service uses a user-assigned identity.
AZURE_CLIENT_ID=

# --- Retrieval backend ---
# Local development uses chroma. Production uses azure_ai_search.
RETRIEVAL_BACKEND=chroma

# --- Azure Document Intelligence ---
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_AUTH_MODE=api_key
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=

# --- Azure AI Search (production retrieval backend) ---
AZURE_SEARCH_ENDPOINT=https://<your-resource>.search.windows.net
AZURE_SEARCH_INDEX_NAME=

# --- Azure Blob Storage (production ingestion backend) ---
STORAGE_BACKEND=local
AZURE_STORAGE_ACCOUNT_URL=https://<your-account>.blob.core.windows.net
AZURE_STORAGE_CONTAINER=legal-rag
AZURE_STORAGE_SOURCE_PREFIX=raw
AZURE_STORAGE_PROCESSED_PREFIX=processed
AZURE_STORAGE_FAILED_PREFIX=failed
AZURE_STORAGE_REPORTS_PREFIX=manifests

# --- Local vector store (development) ---
CHROMA_PERSIST_DIR=.chroma
